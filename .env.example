# PhishShield Configuration

# Flask settings
FLASK_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=3000

# Message analysis settings
MAX_MESSAGE_CHARS=10000
ENABLE_ZERO_SHOT=False
ZERO_SHOT_TIMEOUT=10

# URL analysis settings
MAX_URL_LENGTH=2048

# Translation
ENABLE_TRANSLATION=False

# Threat Intelligence API (optional)
# THREAT_INTEL_API_URL=https://api.example.com

# Database
FEEDBACK_DB_PATH=./feedback.db
SPAM_MODEL_PATH=./spam_pipeline.joblib

# URL models path
URL_MODEL_PATH=./models/url_model.joblib
URL_MODEL_METRICS_PATH=./models/url_model_metrics.json
